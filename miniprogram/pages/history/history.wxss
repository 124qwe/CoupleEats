.page { min-height: 100vh; background: linear-gradient(180deg,#edf5ff,#f8f9ff); }.history-hero { padding: 32rpx; display: flex; justify-content: space-between; align-items: center; border-color: #647aa9; background: #dfeaff; }.history-hero .title { margin-top: 7rpx; font-size: 36rpx; }.tiny-label { color: #b16885; font-size: 22rpx; font-weight: 750; }.hero-ducks { white-space: nowrap; font-size: 48rpx; }.hero-ducks text { color: #e393ae; font-size: 22rpx; }
.stats-row { display: flex; gap: 15rpx; margin: 30rpx 0; }.stat-item { flex: 1; padding: 23rpx 10rpx; text-align: center; border-radius: 24rpx; background: #dfeaff; }.stat-item.pink { background: #f8dce7; }.stat-item.yellow { background: #fff0bd; }.stat-num { font-size: 40rpx; font-weight: 850; }.stat-label { margin-top: 4rpx; color: #747d93; font-size: 21rpx; }
.range-tabs { display: flex; padding: 7rpx; background: #e4eaf5; border-radius: 999rpx; }.range-tab { flex: 1; padding: 17rpx; text-align: center; color: #838a9c; border-radius: 999rpx; font-weight: 700; }.range-tab.active { color: #42567f; background: white; box-shadow: 0 4rpx 12rpx rgba(59,77,116,.1); }
.day-group { margin-top: 34rpx; }.day-title { display: flex; align-items: center; gap: 17rpx; margin: 0 6rpx 17rpx; font-size: 29rpx; font-weight: 800; }.day-line { flex: 1; border-top: 2rpx dashed #ccd4e4; }.day-count { color: #969dae; font-size: 21rpx; font-weight: 400; }.record-card { margin-bottom: 18rpx; padding: 21rpx; display: flex; align-items: center; gap: 20rpx; border-width: 2rpx; }.record-emoji { flex: 0 0 auto; width: 104rpx; height: 104rpx; display: flex; align-items: center; justify-content: center; border-radius: 24rpx; font-size: 57rpx; }.record-main { flex: 1; min-width: 0; }.record-name { font-size: 31rpx; font-weight: 850; }.record-meta { margin-top: 6rpx; color: #7f879a; font-size: 21rpx; }.decider { display: inline-flex; margin-top: 9rpx; padding: 5rpx 12rpx; border-radius: 999rpx; color: #9e5d79; background: #fde8ef; font-size: 19rpx; }.record-type { align-self: flex-start; padding: 7rpx 12rpx; color: #5b74b0; background: #e9efff; border-radius: 12rpx; font-size: 19rpx; }.record-type.manual { color: #a46c30; background: #fff1ce; }.empty { margin-top: 34rpx; border-width: 2rpx; }.empty .secondary-btn { width: 360rpx; margin: 30rpx auto 0; }.loading { padding: 100rpx 0; text-align: center; color: #8f97aa; }

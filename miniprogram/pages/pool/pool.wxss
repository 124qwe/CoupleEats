.page { min-height: 100vh; padding-bottom: 150rpx; background: #f4f7ff; }.pool-header { padding: 25rpx 30rpx 20rpx; background: #edf5ff; }.brand-row { display: flex; align-items: flex-start; justify-content: space-between; }.brand-row .title { font-size: 40rpx; }.add-favorite { padding: 15rpx 22rpx; border-radius: 999rpx; color: #5d74ad; background: white; font-size: 23rpx; font-weight: 750; box-shadow: 0 5rpx 15rpx rgba(74,97,151,.13); }.search-box { height: 76rpx; margin-top: 24rpx; padding: 0 22rpx; display: flex; align-items: center; gap: 14rpx; border-radius: 24rpx; background: rgba(255,255,255,.9); color: #8490ab; }.search-box input { flex: 1; height: 100%; }.search-placeholder { color: #abb1c1; }.clear { padding: 12rpx; font-size: 35rpx; }
.category-scroll { width: 100%; padding: 14rpx 0 20rpx; white-space: nowrap; background: #edf5ff; }.category-row { display: inline-flex; gap: 16rpx; padding: 0 30rpx; }.category-item { width: 110rpx; height: 118rpx; display: inline-flex; flex-direction: column; justify-content: center; align-items: center; gap: 7rpx; border-radius: 24rpx; color: #343a4d; background: #fffef7; box-shadow: 0 6rpx 14rpx rgba(73,91,132,.08); font-size: 23rpx; }.category-item.active { color: #536da9; border: 3rpx solid #7189bf; background: #f6f9ff; font-weight: 800; }.category-emoji { font-size: 38rpx; }
.content { padding: 28rpx 30rpx; }.menu-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 22rpx; }.menu-count { color: #858b9c; }.food-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22rpx; }.food-card { min-width: 0; border-radius: 27rpx; background: #fffef9; overflow: hidden; box-shadow: 0 7rpx 18rpx rgba(65,78,112,.12); border: 3rpx solid transparent; transition: transform .15s; }.food-card.selected { border-color: #718bd0; transform: translateY(-3rpx); box-shadow: 0 9rpx 0 rgba(100,127,192,.2); }.food-visual { position: relative; height: 212rpx; display: flex; justify-content: center; align-items: center; overflow: hidden; }.food-visual::after { content: ''; position: absolute; width: 150rpx; height: 150rpx; border: 3rpx dashed rgba(255,255,255,.7); border-radius: 50%; }.food-emoji { position: relative; z-index: 1; font-size: 92rpx; filter: drop-shadow(0 8rpx 4rpx rgba(46,52,69,.12)); }.favorite-label { position: absolute; z-index: 2; left: 13rpx; top: 13rpx; padding: 7rpx 12rpx; border-radius: 999rpx; color: white; background: #e48cac; font-size: 19rpx; }.favorite-label.builtin { background: rgba(45,54,78,.7); }.select-mark { position: absolute; z-index: 2; right: 13rpx; bottom: 13rpx; width: 57rpx; height: 57rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: white; background: #708bd0; font-size: 37rpx; font-weight: 500; box-shadow: 0 4rpx 10rpx rgba(60,76,116,.24); }.food-copy { padding: 20rpx 18rpx 16rpx; }.food-name-row { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; }.food-name { min-width: 0; font-size: 30rpx; font-weight: 850; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }.heart { color: #7188bf; font-size: 32rpx; }.food-desc { margin-top: 8rpx; min-height: 58rpx; color: #7f8495; font-size: 22rpx; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }.tag-row { display: flex; gap: 7rpx; margin-top: 12rpx; overflow: hidden; }.food-tag { padding: 5rpx 10rpx; border-radius: 999rpx; color: #a25d79; background: #fde9f0; font-size: 19rpx; white-space: nowrap; }.food-actions { margin-top: 15rpx; display: flex; align-items: center; gap: 9rpx; border-top: 2rpx dashed #e7e5de; padding-top: 13rpx; }.eat-now { margin-right: auto; color: #5c75b3; font-weight: 750; font-size: 22rpx; }.mini-action { color: #858b9c; font-size: 20rpx; }.mini-action.delete { color: #c7778b; }
.selection-bar { position: fixed; z-index: 20; left: 22rpx; right: 22rpx; bottom: calc(18rpx + env(safe-area-inset-bottom)); min-height: 102rpx; padding: 14rpx 16rpx 14rpx 24rpx; display: flex; align-items: center; gap: 14rpx; color: white; background: rgba(38,48,76,.94); border-radius: 30rpx; box-shadow: 0 12rpx 36rpx rgba(27,34,55,.3); backdrop-filter: blur(14px); }.selection-info { font-size: 23rpx; }.selected-number { font-size: 34rpx; font-weight: 850; color: #ffd784; }.selection-tip { color: #cbd1e0; font-size: 19rpx; }.clear-selected { color: #d9ddea; font-size: 22rpx; }.wheel-button { margin-left: auto; padding: 19rpx 25rpx; color: #26314d; background: #fff0bd; border-radius: 999rpx; font-size: 25rpx; font-weight: 800; }
.modal-mask { position: fixed; z-index: 100; inset: 0; display: flex; align-items: flex-end; background: rgba(30,38,59,.48); }.editor { width: 100%; padding: 34rpx 34rpx calc(38rpx + env(safe-area-inset-bottom)); border: 0; border-radius: 40rpx 40rpx 0 0; background: #fffef9; box-shadow: none; }.editor-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 28rpx; }.editor-close { padding: 10rpx; color: #848b9d; font-size: 45rpx; }.form-label { margin: 18rpx 4rpx 10rpx; color: #747b90; font-size: 23rpx; font-weight: 700; }.form-input { height: 88rpx; padding: 0 24rpx; border-radius: 20rpx; background: #f2f5fb; color: #26314d; }.form-row { display: flex; gap: 18rpx; }.form-half { flex: 1; }.emoji-half { flex: .45; }.picker-value { display: flex; align-items: center; }.save { margin-top: 32rpx; }

.page { min-height: 100vh; background: linear-gradient(180deg,#edf5ff,#f8f9ff); }.profile-head { display: flex; align-items: center; padding: 16rpx 8rpx 30rpx; }.avatar-button { position: relative; width: 116rpx; height: 116rpx; flex: 0 0 auto; overflow: visible; }.avatar-fallback,.avatar-image { width: 116rpx; height: 116rpx; display: flex; align-items: center; justify-content: center; border: 4rpx solid #29334e; border-radius: 50%; background: #f8dce7; font-size: 47rpx; font-weight: 850; overflow: hidden; }.edit-dot { position: absolute; right: -2rpx; bottom: -2rpx; width: 37rpx; height: 37rpx; display: flex; align-items: center; justify-content: center; border: 3rpx solid white; border-radius: 50%; color: white; background: #718bd0; font-size: 18rpx; }.profile-copy { margin-left: 22rpx; }.profile-name { font-size: 39rpx; font-weight: 850; }.profile-sub { margin-top: 7rpx; color: #7d869c; font-size: 23rpx; }.duck-sticker { margin-left: auto; font-size: 65rpx; transform: rotate(8deg); }
.relationship-card { padding: 30rpx; border-color: #516590; background: #fff8d3; }.relationship-top { display: flex; justify-content: space-between; align-items: flex-start; }.tiny-label { color: #bf7b91; font-size: 19rpx; letter-spacing: 4rpx; }.relationship-top .section-title { margin-top: 5rpx; }.status-pill { padding: 8rpx 14rpx; border-radius: 999rpx; color: #7085b7; background: rgba(255,255,255,.75); font-size: 19rpx; }.people-row { display: flex; align-items: center; justify-content: center; margin: 31rpx 0; gap: 20rpx; }.person { min-width: 125rpx; text-align: center; font-size: 23rpx; font-weight: 700; }.person-avatar { width: 91rpx; height: 91rpx; margin: 0 auto 10rpx; display: flex; align-items: center; justify-content: center; border: 3rpx solid #2a334c; border-radius: 50%; font-size: 35rpx; font-weight: 850; }.person-avatar.me { background: #f5d2df; }.person-avatar.partner { background: #dbe7ff; }.heart-link { flex: 1; display: flex; align-items: center; color: #db8eaa; }.heart-link view { flex: 1; border-top: 3rpx dashed #dda2b5; }.room-info { padding: 19rpx 23rpx; display: flex; justify-content: space-between; align-items: center; border-radius: 20rpx; background: rgba(255,255,255,.72); }.info-label { color: #8b8c91; font-size: 19rpx; }.room-code { margin-top: 3rpx; color: #4d6397; letter-spacing: 6rpx; font-size: 28rpx; font-weight: 850; }.room-info button { padding: 10rpx 18rpx; color: #6078b0; border-radius: 999rpx; background: #e7edff; font-size: 21rpx; }.turn-info { margin-top: 19rpx; text-align: center; color: #9f6579; font-size: 22rpx; }.relationship-card.unbound { text-align: center; }.unbound-icon { font-size: 65rpx; }.unbound .section-title { margin-top: 14rpx; }.unbound .subtitle { margin-top: 9rpx; }.unbound .primary-btn { margin-top: 26rpx; }
.preference-card,.menu-card { margin-top: 27rpx; padding: 29rpx; border-width: 2rpx; }.section-head { display: flex; justify-content: space-between; align-items: flex-start; }.preference-card .section-title { font-size: 31rpx; }.preference-card .subtitle { font-size: 21rpx; }.saving { color: #8c94a6; font-size: 20rpx; }.preference-list { display: flex; flex-wrap: wrap; gap: 13rpx; margin-top: 22rpx; }.preference-chip { padding: 13rpx 18rpx; border: 2rpx solid transparent; border-radius: 999rpx; color: #6d758b; background: #f1f4f9; font-size: 22rpx; }.preference-chip.selected { color: #516ca8; border-color: #8298ca; background: #eaf0ff; font-weight: 750; }
.menu-card { padding-top: 8rpx; padding-bottom: 8rpx; }.menu-item { width: 100%; min-height: 105rpx; display: flex; align-items: center; text-align: left; }.menu-icon { width: 63rpx; height: 63rpx; margin-right: 19rpx; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; }.menu-icon.pink { background: #f9e0e8; }.menu-icon.yellow { background: #fff0bd; }.menu-icon.blue { background: #e2eaff; }.menu-copy { flex: 1; color: #26314c; font-size: 27rpx; font-weight: 750; }.menu-copy text { display: block; margin-top: 3rpx; color: #969cac; font-size: 20rpx; font-weight: 400; }.chevron { color: #a1a7b5; font-size: 43rpx; }.menu-line { height: 2rpx; margin-left: 82rpx; background: #edf0f4; }.feedback { padding: 0; }.unbind-button { margin: 32rpx auto 0; color: #c76d84; font-size: 23rpx; }.version { margin-top: 23rpx; text-align: center; color: #aab0bd; font-size: 19rpx; }
.modal-mask { position: fixed; z-index: 100; inset: 0; display: flex; align-items: flex-end; background: rgba(28,35,55,.52); }.editor { width: 100%; padding: 42rpx 40rpx calc(37rpx + env(safe-area-inset-bottom)); text-align: center; border-radius: 42rpx 42rpx 0 0; background: #fffef9; }.editor-title { font-size: 34rpx; font-weight: 850; }.editor-avatar { width: 105rpx; height: 105rpx; margin: 26rpx auto 22rpx; display: flex; align-items: center; justify-content: center; border: 3rpx solid #2b344d; border-radius: 50%; background: #f8dce7; font-size: 42rpx; font-weight: 800; }.nickname-input { height: 92rpx; padding: 0 25rpx; text-align: center; border-radius: 22rpx; background: #f0f3f9; font-size: 30rpx; }.editor .primary-btn { margin-top: 28rpx; }.cancel-editor { margin: 24rpx auto 0; color: #8b92a2; }

.page { min-height: 100vh; background: #edf5ff; }.container { padding-top: 24rpx; }.couple-banner { width: 100%; height: 250rpx; border-radius: 30rpx; border: 5rpx solid white; box-shadow: 0 9rpx 0 #bfd2ee; }
.heart-seal { width: 92rpx; height: 92rpx; margin: 42rpx auto 24rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #a34f75; background: #f7d5e3; border: 3rpx solid #29324c; font-size: 62rpx; font-weight: 700; }
.centered { text-align: center; }.title.centered { font-size: 42rpx; }.subtitle.centered { margin-top: 14rpx; }
.mode-tabs { width: 520rpx; margin: 38rpx auto 24rpx; padding: 7rpx; display: flex; background: #dfe8f8; border-radius: 999rpx; }.mode-tab { flex: 1; padding: 17rpx 10rpx; text-align: center; color: #79839a; font-weight: 700; border-radius: 999rpx; }.mode-tab.active { color: #34466f; background: white; box-shadow: 0 4rpx 12rpx rgba(71,89,130,.12); }
.code-card,.join-card { margin-top: 18rpx; padding: 38rpx; min-height: 300rpx; border-width: 3rpx; }.field-label { text-align: center; color: #6578af; font-size: 27rpx; font-weight: 750; }.big-code { padding: 32rpx 0 18rpx; text-align: center; color: #26314d; font-size: 62rpx; font-weight: 850; letter-spacing: 21rpx; text-indent: 21rpx; }.code-tip,.mini-hint { text-align: center; color: #9a9faf; font-size: 22rpx; }.share-btn { width: 390rpx; margin: 34rpx auto 0; padding: 20rpx; color: white; background: #7995da; border-radius: 999rpx; font-weight: 750; box-shadow: 0 7rpx 0 #5c74b2; }.refresh-btn { margin: 24rpx auto 0; color: #6e80ad; font-size: 24rpx; }.generate-wrap { padding-top: 8rpx; }.generate-emoji { text-align: center; font-size: 68rpx; margin-bottom: 16rpx; }.generate-wrap .primary-btn { width: 390rpx; margin: 34rpx auto 0; }
.code-input { height: 116rpx; margin-top: 30rpx; padding: 0 30rpx; text-align: center; background: #f8f9ff; border-radius: 16rpx; font-size: 40rpx; font-weight: 800; letter-spacing: 14rpx; color: #26314d; }.input-placeholder { color: #a3a6b1; font-size: 31rpx; letter-spacing: 2rpx; }.mini-hint { margin-top: 18rpx; }.confirm { width: 450rpx; margin: 30rpx auto 0; }.privacy-tip { margin-top: 38rpx; text-align: center; color: #9a9faf; font-size: 23rpx; line-height: 1.7; }
.bound-card { margin: 42rpx 0 34rpx; padding: 42rpx 45rpx; display: grid; grid-template-columns: 1fr 1.5fr 1fr; align-items: center; text-align: center; background: #fff9d9; }.avatar { width: 110rpx; height: 110rpx; margin: auto; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #f5d5e1; border: 3rpx solid #29324c; font-size: 43rpx; font-weight: 800; }.avatar.partner { background: #dbe8ff; }.love-line { color: #dc86aa; font-weight: 800; }.member-name { margin-top: 14rpx; font-weight: 750; }

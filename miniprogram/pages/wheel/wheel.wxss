.page { min-height: 100vh; background: radial-gradient(circle at 50% 23%, #fffbed 0, #edf5ff 48%, #eef4ff 100%); }.wheel-header { text-align: center; }.tiny-label { color: #c67b99; font-size: 22rpx; letter-spacing: 5rpx; font-weight: 750; }.wheel-header .title { margin-top: 10rpx; font-size: 41rpx; }.turn-pill { display: inline-flex; margin-top: 17rpx; padding: 9rpx 20rpx; border-radius: 999rpx; color: #687bac; background: white; font-size: 22rpx; box-shadow: 0 5rpx 14rpx rgba(80,100,146,.1); }
.wheel-stage { position: relative; width: 650rpx; height: 650rpx; margin: 28rpx auto 10rpx; display: flex; align-items: center; justify-content: center; }.wheel-canvas { position: absolute; z-index: 2; width: 610rpx; height: 610rpx; border-radius: 50%; }.wheel-shadow { position: absolute; z-index: 1; width: 610rpx; height: 610rpx; top: 35rpx; border-radius: 50%; background: #6175a4; box-shadow: 0 24rpx 34rpx rgba(55,69,103,.23); }.pointer { position: absolute; z-index: 6; top: 1rpx; left: 50%; width: 0; height: 0; transform: translateX(-50%); border-left: 31rpx solid transparent; border-right: 31rpx solid transparent; border-top: 88rpx solid #e77f9f; filter: drop-shadow(0 5rpx 2rpx rgba(70,48,66,.23)); }.pointer-dot { position: absolute; width: 51rpx; height: 51rpx; left: -25rpx; top: -92rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: white; background: #d96f91; font-size: 20rpx; }.wheel-center { position: absolute; z-index: 5; width: 158rpx; height: 158rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 7rpx solid #29334e; border-radius: 50%; background: #fffef7; box-shadow: 0 5rpx 0 rgba(50,58,80,.16); }.center-duck { font-size: 56rpx; line-height: 1; }.center-text { margin-top: 6rpx; font-size: 20rpx; font-weight: 850; }
.spin-button { width: 430rpx; min-height: 100rpx; margin: 12rpx auto 0; display: flex; gap: 15rpx; align-items: center; justify-content: center; color: white; background: #728dd1; border-radius: 999rpx; box-shadow: 0 9rpx 0 #536ca9, 0 16rpx 25rpx rgba(71,94,150,.23); font-size: 35rpx; font-weight: 850; }.spin-button.spinning { background: #9aaad0; }.spin-icon { font-size: 46rpx; }.under-actions { margin-top: 31rpx; display: flex; justify-content: center; align-items: center; gap: 18rpx; }.under-actions button { color: #69738e; font-size: 23rpx; }.divider { width: 2rpx; height: 23rpx; background: #cdd4e3; }
.candidate-card { margin-top: 38rpx; padding: 28rpx; border-width: 2rpx; background: rgba(255,255,249,.9); }.candidate-head { display: flex; align-items: center; justify-content: space-between; }.candidate-head .section-title { font-size: 29rpx; }.candidate-num { color: #878e9f; font-size: 22rpx; }.candidate-chips { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }.candidate-chip { padding: 10rpx 16rpx; border-radius: 999rpx; color: #59637d; background: #f2f5fb; font-size: 22rpx; }.rule-copy { margin-top: 30rpx; text-align: center; color: #9aa2b5; font-size: 20rpx; line-height: 1.6; }
.empty-wheel { margin: 45rpx 0; padding: 70rpx 30rpx; text-align: center; background: #fffef7; }.empty-plate { font-size: 110rpx; }.empty-wheel .section-title { margin-top: 22rpx; }.empty-wheel .subtitle { margin: 12rpx 0 35rpx; }.empty-actions .secondary-btn { width: 360rpx; margin: auto; }.sync-empty { margin: 27rpx auto 0; color: #6079b3; font-size: 24rpx; }
.result-mask { position: fixed; z-index: 100; inset: 0; display: flex; align-items: flex-end; background: rgba(28,35,55,.57); backdrop-filter: blur(5px); }.result-sheet { position: relative; z-index: 2; width: 100%; padding: 50rpx 46rpx calc(38rpx + env(safe-area-inset-bottom)); text-align: center; border-radius: 48rpx 48rpx 0 0; background: #fffdf4; }.result-tag { display: inline-flex; padding: 9rpx 20rpx; border-radius: 999rpx; color: #ae6281; background: #fde3ed; font-size: 22rpx; font-weight: 750; }.result-emoji { width: 190rpx; height: 190rpx; margin: 28rpx auto 20rpx; display: flex; align-items: center; justify-content: center; border: 4rpx solid #2c354e; border-radius: 50%; box-shadow: 0 9rpx 0 rgba(53,61,83,.14); font-size: 104rpx; }.result-small { color: #878c9c; font-size: 24rpx; }.result-name { margin-top: 7rpx; color: #202a47; font-size: 52rpx; font-weight: 900; }.result-love { margin: 14rpx 0 34rpx; color: #a08090; font-size: 23rpx; }.confirm-food { width: 100%; padding: 25rpx; color: white; background: #728dd1; border-radius: 999rpx; box-shadow: 0 8rpx 0 #566fac; font-size: 31rpx; font-weight: 800; }.result-links { display: flex; justify-content: center; gap: 90rpx; margin-top: 28rpx; }.result-links button { color: #768099; font-size: 24rpx; }.confetti { position: absolute; z-index: 3; color: #ffd67e; font-size: 57rpx; }.confetti.one { left: 9%; top: 29%; }.confetti.two { right: 10%; top: 26%; color: #f1a1bc; }.confetti.three { right: 21%; top: 15%; transform: rotate(20deg); }
